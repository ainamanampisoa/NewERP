
@section Styles {
    <link href="~/css/fournisseurs.css" rel="stylesheet" />
}

<div class="fournisseurs-container">
    <h1 class="fournisseurs-title">
        <i class="fas fa-cube"></i> Creer composant
    </h1>

    <form method="post" asp-controller="Component" asp-action="Create" class="fournisseurs-form">
        <div class="form-grid">
            <div class="form-group">
                <label>Nom</label>
                <input name="name" class="fournisseurs-select" />
            </div>
            <div class="form-group">
                <label>Abbr</label>
                <input name="abbr" class="fournisseurs-select" />
            </div>
            <div class="form-group">
                <label>Type</label>
                <select name="type" class="fournisseurs-select">
                    <option value="Earning">Earning</option>
                    <option value="Deduction">Deduction</option>
                </select>
            </div>
            <div class="form-group button-container">
                <button class="fournisseurs-button primary compact">
                    <i class="fas fa-plus-circle"></i> Ajouter Composant
                </button>
            </div>
        </div>
    </form>
</div>