@model List<NewERP.Models.Employe>

@{
    ViewData["Title"] = "Liste des employés";
    Layout = "_Layout";
}

@section Styles {
    <link href="~/css/fournisseurs.css" rel="stylesheet" />
}

<div class="fournisseurs-container">
    <h1 class="fournisseurs-title">
        <i class="fas fa-users"></i> Salaire des employés
    </h1>

    <form method="get" asp-controller="Alea" asp-action="Generer" class="fournisseurs-form">
        <div class="form-grid">

            <div class="form-group">
                <label>Employe</label>
                <div class="custom-select-container">
                    <select name="employe" class="fournisseurs-select">
                        <option value="">-- Employe --</option>
                        @foreach (var emp in Model)
                        {
                            <option value="@emp.name">@emp.employee_name</option>
                        }
                    </select>
                </div>
            </div>

            <div class="form-group">
                <label>From(Date debut)</label>
                <div class="custom-select-container">
                    <input type="date" class="fournisseurs-select" name="startDate"/>
                </div>
            </div>

            <div class="form-group">
                <label>To(Date fin)</label>
                <div class="custom-select-container">
                    <input type="date" class="fournisseurs-select" name="finDate" />
                </div>
            </div>

            <div class="form-group">
                <label>Salaire</label>
                <div class="custom-select-container">
                    <input type="number" class="fournisseurs-select" name="salaire"/>
                </div>
            </div>

            <div class="form-group button-container">
                <button class="fournisseurs-button primary compact">
                    <i class="fas fa-sliders-h"></i>Valider
                </button>
            </div>
        </div>
    </form>
</div>

<div class="fournisseurs-container">

    <h1 class="fournisseurs-title">
        <i class="fas fa-users"></i> Modification salaire des employés
    </h1>

    <form method="get" asp-controller="Alea" asp-action="Generer" class="fournisseurs-form">
        <div class="form-grid">

            <div class="form-group">
                <label>Employe</label>
                <div class="custom-select-container">
                    <select name="employe" class="fournisseurs-select">
                        <option value="">-- Employe --</option>
                        @foreach (var emp in Model)
                        {
                            <option value="@emp.name">@emp.employee_name</option>
                        }
                    </select>
                </div>
            </div>

            <div class="form-group">
                <label>Éléments de salaire</label>
                <div class="custom-select-container">
                    <select name="elementSalaire" class="fournisseurs-select">
                        <option value="">-- Éléments de salaire --</option>
                        <!-- Tu peux adapter le contenu ici selon tes besoins -->
                        <option value="base">Salaire de base</option>
                        <option value="prime">Prime</option>
                        <option value="bonus">Bonus</option>
                    </select>
                </div>
            </div>

            <div class="form-group">
                <label>Pourcentage</label>
                <div class="custom-select-container">
                    <input type="number" class="fournisseurs-select" name="pourcentage" />
                </div>
            </div>

            <div class="form-group">
                <label>Montant</label>
                <div class="custom-select-container">
                    <input type="number" class="fournisseurs-select" name="montant" />
                </div>
            </div>

            <div class="form-group button-container">
                <button class="fournisseurs-button primary compact">
                    <i class="fas fa-sliders-h"></i>Valider
                </button>
            </div>

        </div>
    </form>

</div>