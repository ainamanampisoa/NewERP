@{
    ViewData["Title"] = "Import des données";
    Layout = "_Layout";
}

@if (TempData["Message"] != null)
{
    <div class="import-alert success">
        <i class="fas fa-check-circle"></i> @TempData["Message"]
    </div>
}
@if (TempData["Erreur"] != null)
{
    <div class="import-alert error">
        <i class="fas fa-exclamation-circle"></i> @TempData["Erreur"]
    </div>
}

@if (ViewBag.Succeess != null)
{
    <div class="alert alert-success">
        @ViewBag.Succeess
    </div>
}

@if (ViewBag.Imported != null)
{
    <div class="alert alert-info">
        <ul>
        @foreach (var msg in ViewBag.Imported as List<string>)
        {
            <li>@msg</li>
        }
        </ul>
    </div>
}

@if (ViewBag.Errors != null)
{
    <div class="alert alert-danger">
        <strong>Erreurs :</strong>
        <ul>
        @foreach (var err in ViewBag.Errors as List<string>)
        {
            <li>@err</li>
        }
        </ul>
    </div>
}

@section Styles {
    <link href="~/css/import.css" rel="stylesheet" />
}

<div class="import-page">
    <div class="import-container">
        <h1 class="fournisseurs-title">
        <i class="fas fa-file-import"></i> Importer les données CSV
        </h1>

       <form method="post" enctype="multipart/form-data" asp-controller="Data" asp-action="Upload">
            <div class="file-group">
                <label for="file1">Fichier 1</label>
                <input type="file" id="file1" name="file1" accept=".csv">          
            </div>

            <div class="file-group">
                <label for="file2">Fichier 2</label>
                <input type="file" id="file2" name="file2" accept=".csv">
            </div>

            <div class="file-group">
                <label for="file3">Fichier 3</label>
                <input type="file" id="file3" name="file3" accept=".csv">
            </div>

            <button type="submit" class="btn-import">Valider</button>
        </form>

        <div class="reset-section">
        <form method="post" asp-controller="Data" asp-action="Reset" onsubmit="return confirm('Voulez-vous vraiment réinitialiser toutes les données ?');">
            <button type="submit" class="btn-reset">
                <i class="fas fa-trash-alt"></i> Réinitialiser les données
            </button>
        </form>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        function confirmReset() {
            if (confirm("Êtes-vous sûr de vouloir réinitialiser toutes les données ? Cette action est irréversible.")) {
                window.location.href = '@Url.Action("ResetData", "Data")';
            }
        }
    </script>
}