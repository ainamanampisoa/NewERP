@model List<NewERP.Models.SalarySlip>
@{
    ViewData["Title"] = "Tableau des employés";
    Layout = "_Layout";
}

@section Styles {
    <link href="~/css/fournisseurs.css" rel="stylesheet" />
}

<div class="fournisseurs-container">
    <h1 class="fournisseurs-title">
        <i class="fas fa-hand-holding-usd"></i>Tableau de salaire des employés
    </h1>
    <form method="get" asp-controller="Employe" asp-action="Tableau" class="fournisseurs-form">
        <div class="form-grid">
            <div class="form-group">
                <label>Mois</label>
                <select id="mois" name="mois" class="fournisseurs-select">
                    <option value="">-- Tous les mois --</option>
                    <option value="1">Janvier</option>
                    <option value="2">Février</option>
                    <option value="3">Mars</option>
                    <option value="4">Avril</option>
                    <option value="5">Mai</option>
                    <option value="6">Juin</option>
                    <option value="7">Juillet</option>
                    <option value="8">Août</option>
                    <option value="9">Septembre</option>
                    <option value="10">Octobre</option>
                    <option value="11">Novembre</option>
                    <option value="12">Décembre</option>
                </select>
            </div>

            <div class="form-group">
                <label>Année</label>
                <select id="annee" name="annee" class="fournisseurs-select">
                    <option value="">-- Toutes les années --</option>
                    @for (int an = 2022; an <= 2026; an++)
                    {
                        <option value="@an">@an</option>
                    }
                </select>
            </div>

            <div class="form-group button-container">
                <button class="fournisseurs-button primary compact">
                    <i class="fas fa-square-check"></i></i> Valider
                </button>
            </div>
        </div>
    </form>

    @if (Model != null && Model.Any())
    {   
        <div class="total-summary">
            <span>Total général :</span>
            <span>
                <i class="fas fa-wallet"></i>
                Gains: <strong>@(((decimal)ViewBag.TotalEarnings).ToString("N0")) $</strong>
            </span>
            <span>
                <i class="fas fa-minus-circle"></i>
                Déductions: <strong>@(((decimal)ViewBag.TotalDeductions).ToString("N0")) $</strong>
            </span>
            <span>
                <i class="fas fa-dollar-sign"></i>
                Salaire net: <strong>@(((decimal)ViewBag.TotalNetPay).ToString("N0")) $</strong>
            </span>
            
            @*@if (ViewBag.TotalByComponent != null)
            {
                foreach (var component in (Dictionary<string, decimal>)ViewBag.TotalByComponent)
                {
                    <span>
                        <i class="fas fa-dollar-sign"></i>
                        @component.Key :
                        <strong>@component.Value.ToString("N0") $</strong>
                    </span>
                }
            }*@
        </div>

        <div class="devis-container">
            <table class="devis-table">
                <thead>
                    <tr>
                        <th>ID</th>
                        <th>Nom</th>
                        <th>Statut</th>
                        <th>Brut</th>
                        <th>Total Deduction</th>
                        <th>Salaire net</th>
                        <th>Earning</th>
                        <th>Mois</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var slip in Model)
                    {
                        <tr>
                            <td>@slip.Name</td>
                            <td>@slip.EmployeeName</td>
                            <td><span class="status-badge success">@slip.Status</span></td>
                            <td>@slip.GrossPay.ToString("N0") $</td>
                            <td>@slip.TotalDeduction.ToString("N0") $</td>
                            <td><strong>@slip.NetPay.ToString("N0") $</strong></td>
                            <td>
                                @if (slip.Earnings != null && slip.Earnings.Any())
                                {
                                    <ul style="list-style-type:none; padding-left:0; margin:0;">
                                        @foreach (var earning in slip.Earnings)
                                        {
                                            <li>
                                                <strong>@earning.SalaryComponent</strong>: @earning.Amount.ToString("N0") $
                                            </li>
                                        }
                                    </ul>
                                }
                                else
                                {
                                    <span>Aucun earning</span>
                                }
                            </td>
                            <td>@slip.StartDate.ToString("MMMM yyyy")</td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    }
    else
    {
        <div class="slipty-state">
            <i class="fas fa-user-slash"></i>
            <h3>Aucun employé trouvé</h3>
            <p>Aucun employé ne correspond à vos critères de recherche</p>
        </div>
    }
    <div class="pagination">
        <ul class="pagination-list">
            @for (int i = 1; i <= (int)ViewBag.TotalPages; i++)
            {
                if (i == (int)ViewBag.CurrentPage)
                {
                    <li class="active"><span>@i</span></li>
                }
                else
                {
                    <li>
                        <a asp-action="Tableau"
                        asp-route-page="@i"
                        asp-route-pageSize="@ViewBag.PageSize"
                        asp-route-mois="@ViewBag.Mois"
                        asp-route-annee="@ViewBag.Annee">@i</a>
                    </li>
                }
            }
        </ul>
    </div>
</div>


