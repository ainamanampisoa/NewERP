@model NewERP.Models.Employe

@{
    ViewData["Title"] = "Fiche Employé";
    Layout = "_Layout";
}

@section Styles {
    <link rel="stylesheet" href="~/css/fiche.css">
}


<div class="container mt-4 fiche-employe"> <!-- Ajoutez fiche-employe ici -->
    <h2 class="mb-4">Fiche Employé : @Model.employee_name</h2>

    <div class="card shadow rounded p-4">
        <dl class="row">
            <dt class="col-sm-3">Identifiant</dt>
            <dd class="col-sm-9">@Model.name</dd>

            <dt class="col-sm-3">Nom complet</dt>
            <dd class="col-sm-9">@Model.employee_name</dd>

            <dt class="col-sm-3">Date de naissance</dt>
            <dd class="col-sm-9">@Model.date_of_birth?.ToString("dd/MM/yyyy")</dd>

            <dt class="col-sm-3">Sexe</dt>
            <dd class="col-sm-9">@Model.gender</dd>

            <dt class="col-sm-3">Date d'embauche</dt>
            <dd class="col-sm-9">@Model.date_of_joining?.ToString("dd/MM/yyyy")</dd>

            <dt class="col-sm-3">Statut</dt>
            <dd class="col-sm-9">@Model.status</dd>

            <dt class="col-sm-3">Département</dt>
            <dd class="col-sm-9">@Model.department</dd>
        </dl>

        <a asp-controller="Employe" asp-action="Index" class="btn btn-secondary mt-3">⬅ Retour à la liste</a>
    </div>
</div>
