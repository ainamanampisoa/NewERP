@model NewERP.Models.Employe

@{
    ViewData["Title"] = "Modifier un employé";
}

<link rel="stylesheet" href="~/css/fournisseurs.css" asp-append-version="true" />

<div class="fournisseurs-container">
    <h1 class="fournisseurs-title">
        <i class="fas fa-user-edit"></i> Modifier un employé
    </h1>

    @if (ViewBag.Erreur != null)
    {
        <div class="fournisseurs-alert error">
            <i class="fas fa-exclamation-circle"></i> @ViewBag.Erreur
        </div>
    }

    <form method="post" asp-controller="Employe" asp-action="Update" class="fournisseurs-form">
        <input type="hidden" name="name" value="@Model.name" />

        <div class="form-group">
            <label>Identifiant employé</label>
            <input class="fournisseurs-select" name="employee_number" value="@Model.employee_number" />
        </div>

        <div class="form-group">
            <label>Nom complet</label>
            <input class="fournisseurs-select" name="employee_name" value="@Model.employee_name" required />
        </div>

        <!-- <div class="form-group">
            <label>Statut</label>
            <select class="fournisseurs-select" name="status">
                <option value="Active" @(Model.status == "Active" ? "selected" : "")>Actif</option>
                <option value="Inactive" @(Model.status == "Inactive" ? "selected" : "")>Inactif</option>
                <option value="Left" @(Model.status == "Left" ? "selected" : "")>Parti</option>
                <option value="Suspended" @(Model.status == "Suspended" ? "selected" : "")>Suspendu</option>
            </select>
            <div class="select-arrow"><i class="fas fa-chevron-down"></i></div>
        </div> -->

        <!-- <div class="form-group">
            <label>Sexe</label>
            <select class="fournisseurs-select" name="gender">
                <option value="Male" @(Model.gender == "Male" ? "selected" : "")>Homme</option>
                <option value="Female" @(Model.gender == "Female" ? "selected" : "")>Femme</option>
                <option value="Other" @(Model.gender == "Other" ? "selected" : "")>Autre</option>
            </select>
        </div> -->

        <div class="form-group">
            <label>Date de naissance</label>
            <input type="date" class="fournisseurs-select" name="date_of_birth" value="@Model.date_of_birth?.ToString("yyyy-MM-dd")" />
        </div>

        <div class="form-group">
            <label>Date d'embauche</label>
            <input type="date" class="fournisseurs-select" name="date_of_joining" value="@Model.date_of_joining?.ToString("yyyy-MM-dd")" />
        </div>

        <div class="form-group">
            <label>Département</label>
            <input class="fournisseurs-select" name="department" value="@Model.department" />
        </div>

        <div class="form-group">
            <label>Poste</label>
            <input class="fournisseurs-select" name="designation" value="@Model.designation" />
        </div>

        <div class="form-group">
            <label>Rapport au manager</label>
            <input class="fournisseurs-select" name="reports_to" value="@Model.reports_to" />
        </div>

        <div class="form-group">
            <label>Email professionnel</label>
            <input class="fournisseurs-select" name="prefered_email" value="@Model.prefered_email" />
        </div>
<!-- 
        <div class="form-group">
            <label>Statut marital</label>
            <select class="fournisseurs-select" name="marital_status">
                <option value="">--</option>
                <option value="Single" @(Model.marital_status == "Single" ? "selected" : "")>Célibataire</option>
                <option value="Married" @(Model.marital_status == "Married" ? "selected" : "")>Marié(e)</option>
                <option value="Divorced" @(Model.marital_status == "Divorced" ? "selected" : "")>Divorcé(e)</option>
            </select>
        </div> -->

        <div class="form-group">
            <label>Numéro de téléphone</label>
            <input class="fournisseurs-select" name="cell_number" value="@Model.cell_number" />
        </div>

        <div class="form-group">
            <label>Adresse actuelle</label>
            <textarea class="fournisseurs-select" name="current_address">@Model.current_address</textarea>
        </div>

        <button type="submit" class="fournisseurs-button primary">
            <i class="fas fa-save"></i> Mettre à jour
        </button>
    </form>
</div>
